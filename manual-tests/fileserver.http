@publicHost = http://localhost:9000
@privateHost = http://localhost:9001
@token = dev-token
@fileId = manual-test

### Public health (open)
GET {{publicHost}}/health

### Private health (open)
GET {{privateHost}}/health

### Upload file (private auth required)
PUT {{privateHost}}/file/{{fileId}}
Authorization: Bearer {{token}}
Content-Type: image/jpeg

< ./testfile.jpg

### Download file (private auth required)
GET {{privateHost}}/file/{{fileId}}
Authorization: Bearer {{token}}

### Generate public URL (private auth required)
POST {{privateHost}}/file/{{fileId}}/public-url
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "duration": 10
}

> {%
  client.global.set("publicUrl", response.body.publicUrl);
  client.global.set("publicId", response.body.publicUrl.split('/').pop());
%}

### Download via generated public URL
GET {{publicHost}}/{{publicId}}

### Negative test: missing auth should return 401
GET {{privateHost}}/file/{{fileId}}

### Negative test: invalid file id should return 400
PUT {{privateHost}}/file/..
Authorization: Bearer {{token}}
Content-Type: application/octet-stream

### upload a temporary file
POST {{privateHost}}/temp-file
Authorization: Bearer {{token}}
Content-Type: image/jpeg

< ./testfile.jpg

> {%
 client.global.set("tempFileId", response.body.tempFileId);
%}

### get the uploaded temporary file
GET {{privateHost}}/temp-file/{{tempFileId}}
Authorization: Bearer {{token}}

### Get the temp file public url
POST {{privateHost}}/temp-file/{{tempFileId}}/public-url
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "duration": "5"
}

### Promote the temp file
POST {{privateHost}}//temp-file/{{tempFileId}}/promote/ny-file
Authorization: Bearer {{token}}

### Generate public url of the promoted file
POST {{privateHost}}/file/ny-file/public-url
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "duration": 10
}

### Cleanup: delete test file
DELETE {{privateHost}}/file/{{fileId}}
Authorization: Bearer {{token}}
